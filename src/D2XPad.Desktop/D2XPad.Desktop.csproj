<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>D2XPad</AssemblyName>
    <RootNamespace>D2XPad.Desktop</RootNamespace>
    <Description>DirectInput to XInput Converter</Description>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <ApplicationIcon>Assets/D2X.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Resource Include="Assets/D2X.ico" />
    <Resource Include="Assets/D2X-stopped.ico" />
    <Resource Include="Assets/D2X-header.png" />
    <AssemblyMetadata Include="D2XPad.ServiceSetup.SHA256" Value="$(D2XPadServiceSetupSha256)"
                      Condition="'$(D2XPadServiceSetupSha256)' != ''" />
    <ProjectReference Include="../D2XPad.Live/D2XPad.Live.csproj" />
    <InternalsVisibleTo Include="CalibrationWizardChecks" />
  </ItemGroup>
</Project>
