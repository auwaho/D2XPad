<UserControl x:Class="D2XPad.Desktop.DeadzoneRangeSlider" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:D2XPad.Desktop"
             MinHeight="24" Focusable="False" Cursor="Hand">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DesktopStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="RangeHandle" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SmallChange" Value="1"/>
        <Setter Property="LargeChange" Value="5"/>
        <Setter Property="TickFrequency" Value="1"/>
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
          <Track x:Name="PART_Track" Minimum="0" Maximum="100" Value="{TemplateBinding Value}">
            <Track.Thumb>
              <Thumb Width="14" Height="14" Focusable="False">
                <Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Border x:Name="Handle" Background="{StaticResource Accent}" CornerRadius="7" BorderThickness="1"/>
                  <ControlTemplate.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True"/>
                        <Condition Binding="{Binding Path=(local:KeyboardFocusCues.Visible), RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                      </MultiDataTrigger.Conditions>
                      <Setter TargetName="Handle" Property="BorderBrush" Value="{StaticResource PrimaryText}"/>
                    </MultiDataTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Background="Transparent">
    <Grid.Style>
      <Style TargetType="Grid">
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
        </Style.Triggers>
      </Style>
    </Grid.Style>
    <Border Background="{StaticResource SurfaceBorder}" CornerRadius="2" Margin="7,0" Height="4" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Canvas x:Name="Rail" Margin="7,0" Height="4" VerticalAlignment="Center" IsHitTestVisible="False" SizeChanged="RailSizeChanged">
      <Border x:Name="Selection" Background="{StaticResource Accent}" CornerRadius="2" Height="4"/>
    </Canvas>
    <Slider x:Name="InnerHandle" Style="{StaticResource RangeHandle}" AutomationProperties.AutomationId="InnerHandle"
            AutomationProperties.Name="{Binding Label, RelativeSource={RelativeSource AncestorType=local:DeadzoneRangeSlider}, StringFormat={}{0} inner deadzone}"
            GotKeyboardFocus="HandleFocused" ValueChanged="HandleValueChanged"/>
    <Slider x:Name="OuterHandle" Style="{StaticResource RangeHandle}" AutomationProperties.AutomationId="OuterHandle"
            AutomationProperties.Name="{Binding Label, RelativeSource={RelativeSource AncestorType=local:DeadzoneRangeSlider}, StringFormat={}{0} outer deadzone threshold}"
            Maximum="100" GotKeyboardFocus="HandleFocused" ValueChanged="HandleValueChanged"/>
  </Grid>
</UserControl>
