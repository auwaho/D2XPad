<UserControl x:Class="D2XPad.Desktop.InputTester"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:D2XPad.Desktop"
             Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI" UseLayoutRounding="True">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DesktopStyles.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SourceSwitch" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" CornerRadius="5" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceBorder}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource ActiveTab}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Instrument" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style x:Key="StickValues" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TriggerBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" Background="Transparent">
                            <Border CornerRadius="3" Background="{StaticResource SurfaceBorder}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
            <Border x:Name="SourceSwitches" DockPanel.Dock="Right" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1"
                    CornerRadius="7" Padding="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once"
                            KeyboardNavigation.DirectionalNavigation="Cycle">
                    <RadioButton x:Name="PhysicalSwitch" Content="Physical input"
                                 IsChecked="True" Style="{StaticResource SourceSwitch}" Checked="SourceChanged"
                                 AutomationProperties.Name="Physical controller input"/>
                    <RadioButton x:Name="OutputSwitch" Content="Xbox output"
                                 Style="{StaticResource SourceSwitch}" Checked="SourceChanged"
                                 AutomationProperties.Name="Virtual Xbox XInput output"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Input tester" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="SourceStatus" Grid.Row="1" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,7,0,14"
                   TextWrapping="Wrap" AutomationProperties.AutomationId="TesterSourceStatus"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Instrument}">
                <StackPanel>
                    <TextBlock Text="Left stick" Style="{StaticResource SectionLabel}"/>
                    <local:StickPlot x:Name="LeftPlot" Height="108" Margin="0,6,0,4"/>
                    <TextBlock x:Name="LeftValues" Style="{StaticResource StickValues}"
                               AutomationProperties.AutomationId="LeftStickValues"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Instrument}">
                <StackPanel>
                    <TextBlock Text="Right stick" Style="{StaticResource SectionLabel}"/>
                    <local:StickPlot x:Name="RightPlot" Height="108" Margin="0,6,0,4"/>
                    <TextBlock x:Name="RightValues" Style="{StaticResource StickValues}"
                               AutomationProperties.AutomationId="RightStickValues"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Instrument}">
                <StackPanel>
                    <TextBlock Text="Triggers" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                    <Grid>
                        <TextBlock Text="LT" Foreground="{StaticResource SecondaryText}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LtPercent" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="LeftTrigger" Style="{StaticResource TriggerBar}" Margin="0,5,0,2"
                                 AutomationProperties.Name="Left trigger" AutomationProperties.AutomationId="LeftTrigger"/>
                    <TextBlock x:Name="LtValue" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource SecondaryText}"/>
                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="RT" Foreground="{StaticResource SecondaryText}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RtPercent" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="RightTrigger" Style="{StaticResource TriggerBar}" Margin="0,5,0,2"
                                 AutomationProperties.Name="Right trigger" AutomationProperties.AutomationId="RightTrigger"/>
                    <TextBlock x:Name="RtValue" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource SecondaryText}"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border x:Name="ButtonsCard" Grid.Row="3" Style="{StaticResource Instrument}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Buttons" Style="{StaticResource SectionLabel}"/>
                <WrapPanel x:Name="ButtonsPanel" Margin="0,8,0,0"/>
                <StackPanel x:Name="ExtraSection">
                    <Border Height="1" Background="{StaticResource SurfaceBorder}" Margin="0,6,0,10"/>
                    <TextBlock Text="Extra buttons" Style="{StaticResource SectionLabel}"/>
                    <WrapPanel x:Name="RearPanel" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
