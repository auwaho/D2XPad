<Window x:Class="D2XPad.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:D2XPad.Desktop"
        Title="D2XPad" Width="1030" Height="602" MinWidth="828" MinHeight="510"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DesktopStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="23"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
      </Style>
      <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/><Setter Property="BorderBrush" Value="{StaticResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="14"/><Setter Property="VerticalAlignment" Value="Top"/>
      </Style>
      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource StartInk}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
      <Style x:Key="PreferenceCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/><Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
          <DockPanel Background="Transparent">
            <Border x:Name="Box" DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Center"
                    Margin="0,0,8,0" CornerRadius="4" Background="{StaticResource FieldBackground}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1">
              <Path x:Name="Check" Data="M 0,4 L 3,7 L 9,0" Stroke="{StaticResource StartInk}" StrokeThickness="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
              <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="ShellTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/><Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                  BorderThickness="1" CornerRadius="6" Padding="12,7">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceBorder}"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{StaticResource ActiveTab}"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="#4B766B"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="ControllerRow" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding Status}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" CornerRadius="5" Padding="9,7" Margin="1,2" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceBorder}"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{StaticResource ActiveTab}"/>
              <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource SurfaceBorder}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" x:Name="StatusBar" Height="30" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource SurfaceBorder}"
            BorderThickness="0,1,0,0" Padding="20,0,14,0" AutomationProperties.Name="Application messages">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Path x:Name="StatusIcon" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform"
              StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              IsHitTestVisible="False" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusMessage" Grid.Column="1" FontSize="12" VerticalAlignment="Center" Visibility="Hidden"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite">
          <TextBlock.ToolTip>
            <ToolTip MaxWidth="540">
              <TextBlock x:Name="StatusTooltipText" TextWrapping="Wrap"/>
            </ToolTip>
          </TextBlock.ToolTip>
        </TextBlock>
        <Button x:Name="CopyStatusDetailsButton" Grid.Column="2" Style="{StaticResource ActionButton}" Width="100" Height="24"
                MinHeight="0" Margin="8,0,0,0" Padding="5,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                Foreground="{StaticResource Secondary}" FontSize="12" Visibility="Collapsed" Click="CopyStatusDetails"
                AutomationProperties.Name="Copy error details">
          <StackPanel Orientation="Horizontal">
            <Path Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center" Stretch="Uniform"
                  Data="M 2,4 H 8 V 10 H 2 Z M 4,2 H 10 V 8 H 9" StrokeThickness="1.1" StrokeLineJoin="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <TextBlock x:Name="CopyStatusDetailsLabel" Text="Copy details"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <Grid>
      <TabControl x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTabChanged" ItemContainerStyle="{StaticResource ShellTab}"
                  AutomationProperties.Name="D2XPad sections" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}"
                  Foreground="{StaticResource PrimaryText}" BorderThickness="0">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <DockPanel Background="{TemplateBinding Background}">
              <Border DockPanel.Dock="Top" Height="64" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="0,0,0,1">
                <StackPanel x:Name="HeaderPanel" IsItemsHost="True" Orientation="Horizontal" Margin="80,0,155,0" HorizontalAlignment="Left"
                            VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"/>
              </Border>
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
            </DockPanel>
          </ControlTemplate>
        </TabControl.Template>
        <TabItem x:Name="ConverterTab" Header="_Converter" AutomationProperties.Name="Converter" IsSelected="True">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20,17" VerticalAlignment="Top">
              <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border x:Name="DeviceCard" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Text="Device" Style="{StaticResource CardTitle}" Margin="0,0,0,11"/>
                    <TextBlock Text="Physical input" Style="{StaticResource FieldCaption}"/>
                    <TextBlock x:Name="DeviceTitle" FontWeight="SemiBold" FontSize="15" Margin="0,3,0,1" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PhysicalStatus" Foreground="{StaticResource SecondaryText}" FontSize="12" FontWeight="Normal" MinHeight="16"
                               TextWrapping="Wrap" Text="Checking controller…"/>
                    <TextBlock x:Name="PhysicalGuidance" Text="Release all controls to continue." Foreground="{StaticResource Warning}"
                               FontSize="12" MinHeight="16" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Hidden" AutomationProperties.LiveSetting="Polite"/>
                    <ComboBox x:Name="DevicePicker" Style="{StaticResource Picker}" Visibility="Collapsed" Margin="0,6,0,0"
                              AutomationProperties.Name="Physical controller" SelectionChanged="DeviceChanged"/>
                    <Border Style="{StaticResource Divider}" Margin="0,11"/>
                    <TextBlock Text="Virtual output" Style="{StaticResource FieldCaption}"/>
                    <TextBlock Text="Xbox Series X|S" FontWeight="SemiBold" FontSize="15" Margin="0,3,0,1"/>
                    <TextBlock x:Name="VirtualStatus" Foreground="{StaticResource SecondaryText}" FontSize="12" FontWeight="Normal" MinHeight="16" TextWrapping="Wrap"/>
                    <Border Style="{StaticResource Divider}" Margin="0,11"/>
                    <Label Target="{Binding ElementName=ProfilePicker}" Content="_Profile" Foreground="{StaticResource PrimaryText}" Padding="0"
                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ProfilePicker" Style="{StaticResource Picker}" IsEnabled="False"
                              AutomationProperties.Name="Profile" SelectionChanged="ProfileChanged"/>
                    <Button x:Name="EditButton" Style="{StaticResource ActionButton}" Content="Edit mappings" Margin="0,6,0,0"
                            IsEnabled="False" Click="EditAssignments"/>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <Button x:Name="ImportButton" Style="{StaticResource ActionButton}" Content="Import profile"
                              MinHeight="28" Padding="2" FontSize="12" Click="ImportProfile"/>
                      <Button x:Name="DeleteButton" Grid.Column="2" Style="{StaticResource ActionButton}" Content="Delete profile"
                              MinHeight="28" Padding="2" FontSize="12" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Click="DeleteProfile"/>
                    </Grid>
                  </StackPanel>
                  <Button x:Name="PowerButton" Grid.Row="2" Style="{StaticResource PrimaryButton}" Content="Start conversion" Margin="0,12,0,0"
                          IsEnabled="False" Click="ToggleConverter"/>
                </Grid>
              </Border>
              <local:InputTester x:Name="Tester" Grid.Column="2"/>
            </Grid>
          </ScrollViewer>
        </TabItem>
        <TabItem x:Name="ControllersTab" Header="C_ontrollers" AutomationProperties.Name="Controllers">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,17">
              <TextBlock Text="Controllers" Style="{StaticResource PageTitle}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <Button x:Name="CalibrateButton" Style="{StaticResource PrimaryButton}" Content="Add controller" Click="CalibrateController"/>
                  <Border Style="{StaticResource Card}" Padding="4" Margin="0,8,0,0">
                    <ListBox x:Name="ControllerList" SelectionChanged="ControllerSelectionChanged" Background="Transparent" BorderThickness="0"
                             AutomationProperties.Name="Known controllers" ItemContainerStyle="{StaticResource ControllerRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="370">
                      <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Status}" Style="{StaticResource FieldCaption}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                      </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <DockPanel>
                        <Button x:Name="RecalibrateButton" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0"
                                Style="{StaticResource ActionButton}" Content="Recalibrate" IsEnabled="False" Click="RecalibrateController"
                                AutomationProperties.HelpText="{Binding Text, ElementName=CalibrationHelp}"/>
                        <StackPanel>
                          <TextBlock Text="Calibration" Style="{StaticResource CardTitle}"/>
                          <TextBlock x:Name="CalibrationOrigin" Style="{StaticResource FieldCaption}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                      </DockPanel>
                      <TextBlock x:Name="CalibrationHelp" Style="{StaticResource FieldCaption}" TextWrapping="Wrap"
                                 Visibility="Collapsed" Margin="0,8,0,0"/>
                      <WrapPanel Margin="0,10,0,0">
                        <ComboBox x:Name="ControllerInstancePicker" Style="{StaticResource Picker}" MinWidth="118" MaxWidth="220" Margin="0,2,6,2"
                                  AutomationProperties.Name="Connected controller instance" Visibility="Collapsed"/>
                        <Button x:Name="UseControllerButton" Content="Set as input" Click="UseController" IsEnabled="False"
                                Style="{StaticResource ActionButton}" Margin="0,2,6,2"/>
                        <Button x:Name="RestoreCalibrationButton" Content="Restore controller" Click="RestoreCalibration" Visibility="Collapsed"
                                Style="{StaticResource ActionButton}" Margin="0,2,6,2"/>
                        <Button x:Name="ForgetButton" Content="Forget controller" Click="ForgetController" Visibility="Collapsed"
                                Style="{StaticResource ActionButton}" Margin="0,2,6,2"/>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                      <TextBlock Text="Vibration" Style="{StaticResource CardTitle}"/>
                      <CheckBox x:Name="GameVibration" Content="Vibration enabled" Style="{StaticResource PreferenceCheck}"
                                Margin="0,6,0,0" Visibility="Collapsed" Checked="GameVibrationChanged" Unchecked="GameVibrationChanged"
                                AutomationProperties.HelpText="{Binding Text, ElementName=VibrationStatus}"/>
                      <TextBlock x:Name="VibrationStatus" Style="{StaticResource FieldCaption}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                      <Button x:Name="TestVibrationButton" Content="Test vibration" HorizontalAlignment="Left" Margin="0,10,0,0"
                              Style="{StaticResource ActionButton}" IsEnabled="False" Click="TestVibration"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem x:Name="SettingsTab" Header="_Settings" AutomationProperties.Name="Settings">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,17">
              <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Stretch">
                  <StackPanel>
                    <TextBlock Text="App" Style="{StaticResource CardTitle}" Margin="0,0,0,7"/>
                    <CheckBox x:Name="StartWithWindows" Content="Start with Windows" Checked="WindowsStartupChanged" Unchecked="WindowsStartupChanged" Style="{StaticResource PreferenceCheck}"/>
                    <CheckBox x:Name="StartMinimized" Content="Start minimized in the tray" Checked="StartMinimizedChanged" Unchecked="StartMinimizedChanged" Style="{StaticResource PreferenceCheck}"/>
                    <CheckBox x:Name="StartAutomatically" Content="Start conversion automatically" Checked="StartAutomaticallyChanged" Unchecked="StartAutomaticallyChanged" Style="{StaticResource PreferenceCheck}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="2" VerticalAlignment="Stretch">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                      <TextBlock Text="Conversion service" Style="{StaticResource CardTitle}"/>
                      <TextBlock x:Name="ConversionServiceStatusText" AutomationProperties.AutomationId="ConversionServiceStatusText"
                                 Style="{StaticResource FieldCaption}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                    </StackPanel>
                    <Button x:Name="InstallConversionServiceButton" Grid.Row="1" AutomationProperties.AutomationId="InstallConversionServiceButton"
                            HorizontalAlignment="Left" Style="{StaticResource ActionButton}"
                            Content="Install service" Click="ChangeConversionService" IsEnabled="False"/>
                  </Grid>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <Grid Height="64" VerticalAlignment="Top" IsHitTestVisible="False" Margin="20,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Accent}">
            <Image Source="Assets/D2X-header.png" Width="27" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="D2XPad"/>
          </Border>
          <Border Width="1" Height="32" Background="{StaticResource SurfaceBorder}" Margin="12,0,0,0"/>
        </StackPanel>
        <Border x:Name="ActivityBadge" CornerRadius="6" Padding="9,4" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Border.Style><Style TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Fill, ElementName=ActivityDot}" Value="{StaticResource Stopped}">
                <Setter Property="Background" Value="#22313A"/>
              </DataTrigger>
            </Style.Triggers>
          </Style></Border.Style>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="ActivityDot" Fill="{StaticResource Stopped}" Width="7" Height="7" Margin="0,0,7,0"/>
            <TextBlock x:Name="ActivityText" Text="Checking…" Foreground="{StaticResource SecondaryText}" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
