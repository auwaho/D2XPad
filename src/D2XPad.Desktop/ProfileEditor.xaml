<Window x:Class="D2XPad.Desktop.ProfileEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:D2XPad.Desktop"
        Title="Profile editor" AutomationProperties.AutomationId="ProfileEditor"
        Width="800" Height="580" MinWidth="560" MinHeight="360" WindowStartupLocation="CenterOwner"
        SourceInitialized="FitToWorkArea" DpiChanged="FitToWorkArea"
        ShowInTaskbar="False" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DesktopStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="WhenTrue"/>
      <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="MinHeight" Value="31"/><Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12"/>
      </Style>
      <Style x:Key="DeadzoneValue" TargetType="TextBlock" BasedOn="{StaticResource FieldCaption}">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="InputItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Surface" CornerRadius="4" Padding="10,6" Margin="0,1" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceBorder}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ActiveTab}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl x:Name="ProfileTabs" ItemContainerStyle="{StaticResource ShellTab}"
                AutomationProperties.Name="Profile sections" AutomationProperties.AutomationId="ProfileTabs">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource SurfaceBorder}"
                    BorderThickness="0,0,0,1" Padding="20,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel IsItemsHost="True" Orientation="Horizontal" HorizontalAlignment="Left"
                            KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                <TextBlock x:Name="DeviceProfileCaption" Grid.Column="2" Style="{StaticResource FieldCaption}" FontSize="13"
                           VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              </Grid>
            </Border>
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
          </DockPanel>
        </ControlTemplate>
      </TabControl.Template>
      <TabItem x:Name="MappingsTab" Header="_Mappings" IsSelected="True"
               AutomationProperties.Name="Mappings" AutomationProperties.AutomationId="MappingsTab">
        <Grid x:Name="Fields" Margin="20,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="0.88*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.42*"/></Grid.ColumnDefinitions>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Physical inputs" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <ListBox x:Name="InputList" AutomationProperties.AutomationId="MappingInputs" AutomationProperties.Name="Physical inputs"
                     BorderBrush="{StaticResource SurfaceBorder}" Background="{StaticResource HeaderBackground}" Padding="3" ItemContainerStyle="{StaticResource InputItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False"
                     SelectionChanged="InputChanged">
              <ListBox.ItemTemplate><DataTemplate>
                <StackPanel>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="Unsaved" Style="{StaticResource FieldCaption}"
                               Foreground="{StaticResource Warning}" Margin="6,0,0,0"
                               Visibility="{Binding IsModified, Converter={StaticResource WhenTrue}}"/>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Summary}" ToolTip="{Binding Summary}" Style="{StaticResource FieldCaption}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <Border Grid.Column="2" Padding="13" CornerRadius="7" Background="{StaticResource CardBackground}" BorderThickness="1" BorderBrush="{StaticResource SurfaceBorder}">
            <DockPanel>
              <WrapPanel DockPanel.Dock="Bottom" Margin="0,9,0,0">
                <Button x:Name="ResetSource" Content="Reset changes" Click="ResetClick" Style="{StaticResource SmallButton}"
                        AutomationProperties.AutomationId="ResetSource" Margin="0,0,6,0" ToolTipService.ShowOnDisabled="True"/>
                <Button x:Name="ClearSource" Content="Clear actions" Click="ClearClick" Style="{StaticResource SmallButton}" MinWidth="91"
                        AutomationProperties.AutomationId="ClearSource"/>
                <Button x:Name="DefaultSource" Content="Use default" Click="DefaultClick" Style="{StaticResource SmallButton}"
                        Margin="6,0,0,0" Visibility="Collapsed" ToolTip="Use the standard Xbox action for the selected input."
                        AutomationProperties.AutomationId="DefaultSource"/>
              </WrapPanel>
              <ScrollViewer x:Name="MappingScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <TextBlock x:Name="SelectedName" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock x:Name="SourceType" Margin="0,2,0,12" Style="{StaticResource FieldCaption}"/>
                  <TextBlock Text="Xbox actions" FontWeight="SemiBold"/>
                  <TextBlock Text="All assigned actions run together." Style="{StaticResource FieldCaption}" Margin="0,2,0,8"/>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="TargetPicker" Style="{StaticResource Picker}" Tag="Select action..." DisplayMemberPath="Name"
                              SelectionChanged="TargetChanged" AutomationProperties.Name="Xbox action" AutomationProperties.AutomationId="ActionTarget">
                      <ComboBox.ToolTip>
                        <Binding Path="SelectedItem.Name" RelativeSource="{RelativeSource Self}"/>
                      </ComboBox.ToolTip>
                      <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource PickerItem}">
                          <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                        </Style>
                      </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <Button x:Name="AddAction" Grid.Column="1" Content="Add" Margin="6,0,0,0" Click="AddClick" Style="{StaticResource SmallButton}"
                            IsEnabled="False" AutomationProperties.Name="Add Xbox action" AutomationProperties.AutomationId="AddAction"/>
                  </Grid>
                  <TextBlock x:Name="EmptyActions" Text="Unassigned" Style="{StaticResource FieldCaption}" Margin="0,5,0,0"/>
                  <ItemsControl x:Name="ActionsList">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Border Background="{StaticResource FieldBackground}" BorderThickness="1" BorderBrush="{StaticResource SurfaceBorder}" CornerRadius="5" Padding="10,6" Margin="0,1,0,4">
                        <StackPanel>
                          <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Remove" Click="RemoveClick" Style="{StaticResource SmallButton}" Margin="5,0,0,0"
                                    AutomationProperties.Name="{Binding RemoveLabel}" AutomationProperties.AutomationId="{Binding RemoveId}"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                          </DockPanel>
                          <Grid Visibility="{Binding IsAnalog, Converter={StaticResource WhenTrue}}" Margin="0,5,0,1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Strength" VerticalAlignment="Center" Style="{StaticResource FieldCaption}"/>
                            <Slider Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Minimum="1" Maximum="100" SmallChange="1" LargeChange="10"
                                    IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" Style="{StaticResource StrengthSlider}"
                                    Value="{Binding Strength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="{Binding StrengthLabel}" AutomationProperties.AutomationId="{Binding StrengthId}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Strength, StringFormat={}{0}%}" FontFamily="Consolas"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem x:Name="SticksTab" Header="_Sticks" AutomationProperties.Name="Sticks" AutomationProperties.AutomationId="SticksTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,14">
          <Grid VerticalAlignment="Top">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1"
                    CornerRadius="7" Padding="13">
              <StackPanel>
                <TextBlock Text="Stick deadzones" FontSize="17" FontWeight="SemiBold"/>
                <DockPanel Margin="0,11,0,0">
                  <TextBlock x:Name="LeftDeadzoneValue" DockPanel.Dock="Right" Style="{StaticResource DeadzoneValue}"/>
                  <TextBlock Text="Left stick"/>
                </DockPanel>
                <local:DeadzoneRangeSlider x:Name="LeftDeadzone" Label="Left stick" RangeChanged="DeadzoneChanged"
                                          AutomationProperties.AutomationId="LeftDeadzone"/>
                <DockPanel Margin="0,6,0,0">
                  <TextBlock x:Name="RightDeadzoneValue" DockPanel.Dock="Right" Style="{StaticResource DeadzoneValue}"/>
                  <TextBlock Text="Right stick"/>
                </DockPanel>
                <local:DeadzoneRangeSlider x:Name="RightDeadzone" Label="Right stick" RangeChanged="DeadzoneChanged"
                                          AutomationProperties.AutomationId="RightDeadzone"/>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,8,0">
                  <TextBlock Text="Left stick" Style="{StaticResource FieldCaption}" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                  <local:StickDeadzonePreview x:Name="LeftStickPreview" Width="128" Height="128"
                                             AutomationProperties.Name="Left stick deadzone preview"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Right stick" Style="{StaticResource FieldCaption}" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                  <local:StickDeadzonePreview x:Name="RightStickPreview" Width="128" Height="128"
                                             AutomationProperties.Name="Right stick deadzone preview"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0">
                <Ellipse Width="9" Height="9" Stroke="{StaticResource PrimaryText}" StrokeThickness="1.2"
                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="Physical" Style="{StaticResource FieldCaption}" Margin="0,0,12,0"/>
                <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="Filtered" Style="{StaticResource FieldCaption}"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border x:Name="EditorFooter" Grid.Row="1" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="0,1,0,0" Padding="20,10">
      <StackPanel>
        <Label Content="_Profile name" Target="{Binding ElementName=ProfileName}" Foreground="{StaticResource PrimaryText}" Padding="0,0,0,4" FontSize="12"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="ProfileName" MaxLength="250" MinHeight="36" VerticalContentAlignment="Center" Padding="7,2" Background="{StaticResource FieldBackground}"
                   Foreground="{StaticResource PrimaryText}" CaretBrush="{StaticResource PrimaryText}" BorderBrush="{StaticResource SurfaceBorder}" SelectionBrush="{StaticResource Accent}" TextChanged="ProfileNameChanged"
                   AutomationProperties.Name="Profile name" AutomationProperties.AutomationId="ProfileName"/>
          <Button x:Name="CancelEditor" Grid.Column="1" Content="Cancel" IsCancel="True" Margin="10,0,6,0" Style="{StaticResource ActionButton}"/>
          <Button x:Name="SaveProfile" Grid.Column="2" Content="Save and apply" IsDefault="True" Style="{StaticResource ActionButton}"
                  FontWeight="SemiBold" Foreground="{StaticResource StartInk}" Background="{StaticResource Accent}"
                  BorderBrush="{StaticResource Accent}" Click="SaveClick" AutomationProperties.AutomationId="SaveProfile"/>
        </Grid>
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="EditorMessage" TextWrapping="Wrap" MinHeight="16" Style="{StaticResource FieldCaption}"
                     AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="EditorMessage"/>
          <TextBlock x:Name="PendingChanges" Grid.Column="1" Text="Unsaved changes" Style="{StaticResource FieldCaption}"
                     Foreground="{StaticResource Warning}" Margin="10,0,0,0" Visibility="Hidden" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
