<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SdkDir>$(MSBuildThisFileDirectory)../../artifacts/deps/HIDMaestro-2.3.0</SdkDir>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="D2XPad" />
    <InternalsVisibleTo Include="CalibrationWizardChecks" />
    <Compile Include="../D2XPad.Capture/RawInput.cs" Link="RawInput.cs" />
    <Compile Include="../D2XPad.SeriesProbe/BrowserProbe.cs" Link="BrowserProbe.cs" />
    <Compile Include="../D2XPad.SeriesProbe/XInputReader.cs" Link="XInputReader.cs" />
    <Compile Include="../D2XPad.InputGame/GameActions.cs" Link="GameActions.cs" />
    <Compile Include="../Shared/SeriesController.cs" Link="SeriesController.cs" />
    <Compile Include="../Shared/BrowserWindow.cs" Link="BrowserWindow.cs" />
    <Reference Include="HIDMaestro.Core" HintPath="$(SdkDir)/HIDMaestro.Core.dll" />
    <EmbeddedResource Include="85hf-bindings.json" LogicalName="D2XPad.Profiles.default.json" />
    <EmbeddedResource Include="southpaw-buttons.json" LogicalName="D2XPad.Profiles.southpaw-buttons.json" />
    <None Include="$(SdkDir)/LICENSE;$(SdkDir)/THIRD-PARTY-NOTICES.txt" Link="HIDMaestro/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="live-gamepad.html" LogicalName="D2XPad.SeriesProbe.gamepad.html" />
  </ItemGroup>
  <PropertyGroup Condition="'$(MeasureLiveLatency)' == 'true'">
    <DefineConstants>$(DefineConstants);D2XPAD_LATENCY_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(MeasureLiveLatency)' == 'true'">
    <Compile Include="../../tests/ServiceOutput/PhysicalLatencyProbe.cs" Link="Diagnostics/PhysicalLatencyProbe.cs" />
  </ItemGroup>
</Project>
