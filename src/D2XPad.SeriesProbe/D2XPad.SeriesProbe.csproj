<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SdkDir>$(MSBuildThisFileDirectory)../../artifacts/deps/HIDMaestro-2.2.0</SdkDir>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/SeriesController.cs" Link="SeriesController.cs" />
    <Compile Include="../Shared/BrowserWindow.cs" Link="BrowserWindow.cs" />
    <Reference Include="HIDMaestro.Core" HintPath="$(SdkDir)/HIDMaestro.Core.dll" />
    <None Include="$(SdkDir)/LICENSE;$(SdkDir)/THIRD-PARTY-NOTICES.txt" Link="HIDMaestro/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="gamepad.html" LogicalName="D2XPad.SeriesProbe.gamepad.html" />
  </ItemGroup>
  <Target Name="CheckSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SdkDir)/HIDMaestro.Core.dll')" Text="Run scripts/Build-SeriesProbe.ps1 to fetch the pinned HIDMaestro SDK." />
  </Target>
</Project>
